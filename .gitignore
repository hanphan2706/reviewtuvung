# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates

# Từ điển StarDict / Kindle — chỉ local (bản quyền + file lớn).
/dictionaries/
data/dictionary/en-vi-stardict.json

# Tài liệu / audio bản quyền hoặc file lớn — không commit lên repo công khai.
/materials/
/transcript/

# Bài đọc raw (Cambridge…) — chỉ local; đáp án đề thi thật được commit.
/reading raw/*
!/reading raw/real test 1.txt

# Audio nghe pilot (Cambridge…) — chỉ local / deploy riêng, không commit mp3.
/public/listening-assets/cam19/*.mp3
/listening materials/Audio cam/*.mp3
/listening materials/Audio real test/*.mp3
/listening materials/*.zip

# Cache Whisper build (regen bằng npm run listening:sync-transcript).
/listening materials/sync/*.whisper-words.json
.venv-listening/

# Audio luyện đọc — upload Supabase Storage (bucket private), không commit.
/public/reading-audio/*.mp3