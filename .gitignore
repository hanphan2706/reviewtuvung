# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

certificates

# Cursor rules / IDE local
/.cursor/

# Mockup & design exports — chỉ local
/course info/
/course info.zip
/stitch_export/
/stitch_export_1/
/stitch_interactive_english_media_portal*.zip
/public/stitch/

# Từ điển StarDict / Kindle — chỉ local (bản quyền + file lớn).
/dictionaries/
data/dictionary/en-vi-stardict.json

# Tài liệu thả vào (PDF sách, zip audio…) — chỉ local
/materials/
/vocab materials/
/grammar materials/
/transcript/

# Bản dịch WIP — chỉ local
/reading translations/_work/

# Bài đọc raw (Cambridge, Compass…) — chỉ local; ngoại lệ file dev nhỏ
/reading raw/*
!/reading raw/real test 1.txt
!/reading raw/de-thi-that-1.txt

# Listening — binary / bản quyền (giữ .txt, .json sync trong repo cho pipeline)
/listening materials/**/*.mp3
/listening materials/**/*.pdf
/listening materials/**/*.zip
/listening materials/**/*.rar
/listening materials/**/*.jpg
/listening materials/*.jpg
!/listening materials/cam * test * part * map.jpg
!/listening materials/cam * test * part * map.jpeg
/listening materials/_work/
/listening materials/sync/*.whisper-words.json
.venv-listening/
/scripts/.cache/

# Audio nghe — deploy qua Supabase / API, không commit file gốc
/public/listening-assets/**/*.mp3
/public/listening-assets/**/*.wav

# Audio luyện đọc — upload Supabase Storage (bucket private)
/public/reading-audio/*.mp3

# Đề giữa kỳ — asset local (HTML template có thể vẫn track riêng nếu cần)
/public/midterm-assets/
!/public/midterm-assets/.gitkeep
