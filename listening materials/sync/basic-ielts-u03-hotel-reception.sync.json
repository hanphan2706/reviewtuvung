    },
    {
      "id": "cue-4",
      "speaker": null,
      "text": "Good evening, sir.",
      "start": 12.65,
      "end": 14.91
    },
    {
      "id": "cue-5",
      "speaker": null,
      "text": "Good evening.",
      "start": 14.91,
      "end": 15.83
    },
    {
      "id": "cue-6",
      "speaker": null,
      "text": "My name is Arthur Collins.",
      "start": 15.83,
      "end": 18.05
    },
    {
      "id": "cue-7",
      "speaker": null,
      "text": "I believe you have a room reserved for me.",
      "start": 18.05,
      "end": 21.11
    },
    {
      "id": "cue-8",
      "speaker": null,
      "text": "Just a moment, Mr. Collins.",
      "start": 21.11,
      "end": 22.49
    },
    {
      "id": "cue-9",
      "speaker": null,
      "text": "Let me see.",
      "start": 22.49,
      "end": 23.71
    },
    {
      "id": "cue-10",
      "speaker": null,
      "text": "Collins.",
      "start": 23.71,
      "end": 24.55
    },
    {
      "id": "cue-11",
      "speaker": null,
      "text": "Yes.",
      "start": 24.55,
      "end": 25.41
    },
    {
      "id": "cue-12",
      "speaker": null,
      "text": "Mr. Collins, you booked a single room three days ago.",
      "start": 25.41,
      "end": 29.09
    },
    {
      "id": "cue-13",
      "speaker": null,
      "text": "Is that right?",
      "start": 29.09,
      "end": 30.43
    },
    {
      "id": "cue-14",
      "speaker": null,
      "text": "Yes, that's right.",
      "start": 30.43,
      "end": 31.51
    },
    {
      "id": "cue-15",
      "speaker": null,
      "text": "Mr. Collins, your room number is 405 on the fourth floor.",
      "start": 31.51,
      "end": 37.35
    },
    {
      "id": "cue-16",
      "speaker": null,
      "text": "Would you fill in this form, please?",
      "start": 37.35,
      "end": 40.59
    },
    {
      "id": "cue-17",
      "speaker": null,
      "text": "Certainly.",
      "start": 40.59,
      "end": 42.67
    },
    {
      "id": "cue-18",
      "speaker": null,
      "text": "How long do you intend to stay in the hotel, Mr. Collins?",
      "start": 42.67,
      "end": 46.75
    },
    {
      "id": "cue-19",
      "speaker": null,
      "text": "Let me see.",
      "start": 46.75,
      "end": 47.87
    },
    {
      "id": "cue-20",
      "speaker": null,
      "text": "Today is Monday and probably I'm going to leave on Friday morning.",
      "start": 47.87,
      "end": 53.99
    },
    {
      "id": "cue-21",
      "speaker": null,
      "text": "On Friday morning, I see.",
      "start": 53.99,
      "end": 56.71
    },
    {
      "id": "cue-22",
      "speaker": null,
      "text": "Oh, excuse me.",
      "start": 56.71,
      "end": 58.43
    },
    {
      "id": "cue-23",
      "speaker": null,
      "text": "Where shall I put my passport number?",
      "start": 58.43,
      "end": 60.81
    },
    {
      "id": "cue-24",
      "speaker": null,
      "text": "Just at the bottom.",
      "start": 60.81,
      "end": 61.95
    },
    {
      "id": "cue-25",
      "speaker": null,
      "text": "That's right.",
      "start": 61.95,
      "end": 63.01
    },
    {
      "id": "cue-26",
      "speaker": null,
      "text": "Thank you.",
      "start": 63.01,
      "end": 64.59
    },
    {
      "id": "cue-27",
      "speaker": null,
      "text": "Oh, would you please wake me up at 710 in the morning, please?",
      "start": 64.59,
      "end": 69.07
    },
    {
      "id": "cue-28",
      "speaker": null,
      "text": "10 past 7, certainly.",
      "start": 69.07,
      "end": 71.73
    },
    {
      "id": "cue-29",
      "speaker": null,
      "text": "Porter, please take Mr. Collins suitcase to his room.",
      "start": 71.73,
      "end": 76.19
    },
    {
      "id": "cue-30",
      "speaker": null,
      "text": "Mr. Collins, please follow him.",
      "start": 76.19,
      "end": 78.45
    },
    {
      "id": "cue-31",
      "speaker": null,
      "text": "Thank you.",
      "start": 78.45,
      "end": 79.33
    },
    {
      "id": "cue-32",
      "speaker": null,
      "text": "You're welcome.",
      "start": 79.33,
      "end": 81.612
    }
  ]
