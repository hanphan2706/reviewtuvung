      "start": 14.07,
      "end": 20.75
    },
    {
      "id": "cue-4",
      "speaker": null,
      "text": "This lesson is for practice in hearing the differences in the following pairs of numbers.",
      "start": 20.75,
      "end": 25.85
    },
    {
      "id": "cue-5",
      "speaker": null,
      "text": "13, 30, 14, 40, 15, 50, 16, 60, 17, 70, 18, 80, 19, 90.",
      "start": 25.85,
      "end": 43.95
    },
    {
      "id": "cue-6",
      "speaker": null,
      "text": "It is important to listen to the last part of each word.",
