  "cues": [
    {
      "id": "cue-1",
      "speaker": null,
      "text": "Hi, Ryan.",
      "start": 0,
      "end": 1.46
    },
    {
      "id": "cue-2",
      "speaker": null,
      "text": "Oh, hi.",
      "start": 1.46,
      "end": 3.2
    },
    {
      "id": "cue-3",
      "speaker": null,
      "text": "Are you still working in the bank?",
      "start": 3.2,
      "end": 5.32
    },
    {
      "id": "cue-4",
      "speaker": null,
      "text": "Yeah. 2.",
      "start": 5.32,
      "end": 9.22
    },
    {
      "id": "cue-5",
      "speaker": null,
      "text": "Where are you working now, Bridget?",
      "start": 9.22,
      "end": 11.62
    },
    {
      "id": "cue-6",
      "speaker": null,
      "text": "I just started as a chef in an Italian restaurant. Come and try my food.",
      "start": 11.62,
      "end": 16.56
    },
    {
      "id": "cue-7",
      "speaker": null,
      "text": "Sounds great. I'd love to.",
      "start": 16.56,
      "end": 20.5
    },
    {
      "id": "cue-8",
      "speaker": null,
      "text": "3.",
      "start": 20.5,
      "end": 21.74
    },
    {
      "id": "cue-9",
      "speaker": null,
      "text": "Are you still at school, Jake?",
      "start": 21.74,
      "end": 24.42
    },
    {
      "id": "cue-10",
      "speaker": null,
      "text": "No. I graduated from college last month.",
      "start": 24.42,
      "end": 27.8
    },
    {
      "id": "cue-11",
      "speaker": null,
      "text": "Congratulations. And what are you doing now?",
      "start": 27.8,
      "end": 31.76
    },
    {
      "id": "cue-12",
      "speaker": null,
      "text": "Nothing much. I'm tired. I'm taking a long vacation.",
      "start": 31.76,
      "end": 37.32
    },
    {
      "id": "cue-13",
      "speaker": null,
      "text": "4. What do you do, Marie?",
      "start": 37.32,
      "end": 40.92
    },
    {
      "id": "cue-14",
      "speaker": null,
      "text": "Me? I'm a lawyer.",
      "start": 40.92,
      "end": 42.78
    },
    {
      "id": "cue-15",
      "speaker": null,
      "text": "How long have you been doing that?",
      "start": 42.78,
      "end": 44.42
    },
    {
      "id": "cue-16",
      "speaker": null,
      "text": "For about five years. Do you need a good lawyer?",
      "start": 44.42,
      "end": 48.6
    },
    {
      "id": "cue-17",
      "speaker": null,
      "text": "Well, not yet. 5.",
      "start": 48.6,
      "end": 53.7
    },
    {
      "id": "cue-18",
      "speaker": null,
      "text": "Are you a receptionist, Suzanne?",
      "start": 53.7,
      "end": 56.44
    },
    {
      "id": "cue-19",
      "speaker": null,
      "text": "Yes, I am.",
      "start": 56.44,
      "end": 57.76
    },
    {
      "id": "cue-20",
      "speaker": null,
      "text": "Do you like the people you work with?",
      "start": 57.76,
      "end": 60.02
    },
    {
      "id": "cue-21",
      "speaker": null,
      "text": "Well, it's my first week on the job, so I'm not sure yet.",
      "start": 60.02,
      "end": 65.56
    },
    {
      "id": "cue-22",
      "speaker": null,
      "text": "6.",
      "start": 65.56,
      "end": 67.18
    },
    {
      "id": "cue-23",
      "speaker": null,
      "text": "Are you still a tennis instructor, Rose?",
      "start": 67.18,
      "end": 69.7
    },
    {
      "id": "cue-24",
      "speaker": null,
      "text": "No, I'm not. I didn't like it.",
      "start": 69.7,
      "end": 72.92
    },
    {
      "id": "cue-25",
      "speaker": null,
      "text": "So what are you doing now?",
      "start": 72.92,
      "end": 74.54
    },
    {
      "id": "cue-26",
      "speaker": null,
      "text": "Well, I'm trying to find a new job.",
      "start": 74.54,
      "end": 78.74
    },
    {
      "id": "cue-27",
      "speaker": null,
      "text": "7.",
      "start": 78.74,
      "end": 80.22
    },
    {
      "id": "cue-28",
      "speaker": null,
      "text": "Do you work in an office, Patrick?",
      "start": 80.22,
      "end": 82.58
    },
    {
      "id": "cue-29",
      "speaker": null,
      "text": "Not anymore. Now I'm an English teacher.",
      "start": 82.58,
      "end": 85.98
    },
    {
      "id": "cue-30",
      "speaker": null,
      "text": "I just had my first class.",
      "start": 85.98,
      "end": 87.9
    },
    {
      "id": "cue-31",
      "speaker": null,
      "text": "Really? How was it?",
      "start": 87.9,
      "end": 90.36
    },
    {
      "id": "cue-32",
      "speaker": null,
      "text": "It was terrific.",
      "start": 90.36,
      "end": 93.5
    },
    {
      "id": "cue-33",
      "speaker": null,
      "text": "8.",
      "start": 93.5,
      "end": 94.94
    },
    {
      "id": "cue-34",
      "speaker": null,
      "text": "Are you still working at the bookstore, Allison?",
      "start": 94.94,
      "end": 97.52
    },
    {
      "id": "cue-35",
      "speaker": null,
      "text": "Yeah, but I don't like it.",
      "start": 97.52,
      "end": 100.12
    },
    {
      "id": "cue-36",
      "speaker": null,
      "text": "I have to stand all day, and I get so tired.",
      "start": 100.12,
      "end": 104.14
    },
    {
      "id": "cue-37",
      "speaker": null,
      "text": "I'm sorry to hear that.",
      "start": 104.14,
      "end": 108.516
    }
  ]
