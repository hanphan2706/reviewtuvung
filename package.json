{
  "name": "reviewtuvung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:lan": "node scripts/dev-lan.mjs",
    "lan:oauth-setup": "npx tsx scripts/print-lan-oauth-setup.ts",
    "dev:lan:https": "next dev --turbopack -H 0.0.0.0 --experimental-https",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "prod": "next build && next start",
    "prod:lan": "next build && next start -H 0.0.0.0",
    "ngrok": "ngrok http 3000",
    "lint": "eslint",
    "transcript:clean": "npx tsx scripts/clean-listening-transcript.ts",
    "listening:prepare-real-test-transcript": "npx tsx scripts/prepare-real-test-listening-transcript.ts",
    "listening:generate-real-test-transcript": "npx tsx scripts/generate-real-test-listening-transcript.ts",
    "dictionary:import-vi": "npx tsx scripts/import-wiktionary-vi.ts --academic-only",
    "dictionary:import-vi:all": "npx tsx scripts/import-wiktionary-vi.ts",
    "dictionary:import-vi:quick": "npx tsx scripts/import-wiktionary-vi.ts --academic-only --limit 50",
    "dictionary:merge-passage-vi": "npx tsx scripts/merge-passage-glossary-into-wiktionary.ts",
    "dictionary:import-stardict": "npx tsx scripts/import-stardict-vi.ts",
    "dictionary:import-stardict:quick": "npx tsx scripts/import-stardict-vi.ts --limit 8000",
    "dictionary:upload-stardict": "npx tsx scripts/upload-stardict.ts",
    "reading:build-challenge-2": "python3 scripts/build-reading-challenge-2.py",
    "reading:apply-challenge-2-vi": "npx tsx scripts/apply-reading-challenge-2-vi.ts",
    "reading:trim-compass-audio": "node scripts/trim-reading-challenge-audio.mjs",
    "reading:upload-audio": "npx tsx scripts/upload-reading-audio.ts",
    "listening:prepare-audio-for-upload": "npx tsx scripts/prepare-listening-audio-for-upload.ts",
    "listening:upload-audio": "npx tsx scripts/upload-listening-audio.ts",
    "media:upload-audio": "npx tsx scripts/upload-media-audio.ts",
    "reading:sync-images": "npx tsx scripts/sync-reading-images.ts",
    "listening:sync-tactics": "npx tsx scripts/sync-tactics-listening.ts",
    "listening:sync-transcript": "npx tsx scripts/sync-listening-transcript.ts",
    "exam:build-midterm": "node scripts/build-midterm-exam-html.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.0",
    "dompurify": "^3.4.1",
    "emoji-picker-element": "^1.29.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "wink-lemmatizer": "^3.0.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
